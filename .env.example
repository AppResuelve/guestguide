# Contraseña para entrar a /admin. Elegí una propia, no uses esta.
ADMIN_PASSWORD=cambiar-esta-contraseña

# Connection string del Edge Config (Vercel la genera al crear el store).
# Storage > Edge Config > tu store > "Connection string"
EDGE_CONFIG=

# ID del Edge Config (se ve en la URL del store o en su configuración).
EDGE_CONFIG_ID=

# Token de Vercel con permiso de escritura sobre este proyecto/Edge Config.
# Se genera en Account Settings > Tokens.
# (No lo llames VERCEL_API_TOKEN: Vercel reserva ese prefijo y no te va a
# dejar crear la variable con ese nombre.)
EDGE_CONFIG_TOKEN=
