# Contraseña para entrar a /admin. Elegí una propia, no uses esta.
ADMIN_PASSWORD=cambiar-esta-contraseña

# Connection string del Global Config. Vercel la crea sola al conectar el
# store al proyecto — no hace falta cargarla a mano.
GLOBAL_CONFIG=

# ID del Global Config (formato ecfg_xxxxxxxx, se ve en el dashboard del store).
GLOBAL_CONFIG_ID=

# Token de Vercel con permiso de escritura sobre este Global Config.
# Se genera en Account Settings > Tokens.
GLOBAL_CONFIG_TOKEN=
